# ============================================================
# GestorEng — copie para ".env" e ajuste. NUNCA versione o .env.
# Gere segredos com:  openssl rand -base64 48
# ============================================================
TZ=America/Sao_Paulo
WEB_PORT=8080

# Segredos obrigatórios (mín. 32 caracteres cada, diferentes entre si)
SECRET_KEY=troque-por-um-valor-aleatorio-longo
ENCRYPTION_KEY=troque-por-outro-valor-aleatorio-longo

# Primeiro administrador (criado só se o banco estiver vazio)
ADMIN_EMAIL=admin@velmont.com.br
ADMIN_PASSWORD=TroqueEstaSenha@2026
ADMIN_NAME=Administrador

# Origens permitidas (inclua as do app Android)
CORS_ORIGINS=https://gestor.velmont.com.br,capacitor://localhost,https://localhost
# false apenas se acessar SEM https (ex.: http://IP-da-rede-local)
COOKIE_SECURE=true
MAX_UPLOAD_MB=25
WEB_CONCURRENCY=3

# ---------- docker-compose.yml (completo) ----------
POSTGRES_DB=gestoreng
POSTGRES_USER=gestoreng
POSTGRES_PASSWORD=troque-esta-senha-do-banco
REDIS_PASSWORD=troque-esta-senha-do-redis

# ---------- docker-compose.external.yml (serviços existentes) ----------
# Rede Docker onde já estão o Postgres e o Redis (ex.: criada pelo ZimaOS/Portainer)
EXTERNAL_NETWORK=infra
# DATABASE_URL=postgresql+psycopg://usuario:senha@postgres:5432/gestoreng
# REDIS_URL=redis://:senha@redis:6379/0?prefix=gestoreng   (opcional; vazio = sem Redis)
#   - senha com caracteres especiais deve ser codificada: @ -> %40, # -> %23, : -> %3A, / -> %2F
#   - Redis 6+ com usuário ACL: redis://usuario:senha@redis:6379/0
#   - TLS: rediss://...
# Prefixo das chaves (alternativa ao ?prefix= da URL). Padrão: gestoreng:
# REDIS_PREFIX=velmont

# Imagens publicadas pelo GitHub Actions (ou use "build" local)
IMAGE_API=ghcr.io/incorpore/gestoreng-api:latest
IMAGE_WEB=ghcr.io/incorpore/gestoreng-web:latest
